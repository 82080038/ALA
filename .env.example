# ── PostgreSQL ──────────────────────────────────────
POSTGRES_PASSWORD=change_me_postgres_secret
# Password role aplikasi non-superuser `ala_app` (RLS ditegakkan).
# Kosongkan untuk memakai POSTGRES_PASSWORD.
APP_DB_PASSWORD=

# ── Neo4j ───────────────────────────────────────────
NEO4J_PASSWORD=change_me_neo4j_secret

# ── LLM Provider (Local Ollama — CUDA GPU) ────────
# Dual-instance GPU pinning (anti-OOM pada 2× GTX 1050 Ti 4 GB):
#   :11434 → GPU 0 (CUDA_VISIBLE_DEVICES=0) → qwen2.5:3b-instruct
#   :11435 → GPU 1 (CUDA_VISIBLE_DEVICES=1) → qwen2.5-coder:3b
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_REASONING_URL=http://host.docker.internal:11434
OLLAMA_CODER_URL=http://host.docker.internal:11435
OLLAMA_MODEL_REASONING=qwen2.5:3b-instruct
OLLAMA_MODEL_CODER=qwen2.5-coder:3b
OLLAMA_TEMPERATURE_REASONING=0.2
OLLAMA_TEMPERATURE_CODER=0.1

# ── Google Custom Search (opsional — ALCD & Internet Crawler) ──
# Digunakan HANYA untuk menemukan dokumen hukum publik & tren kejahatan.
# LLM tetap lokal via Ollama — tidak ada inferensi cloud.
GOOGLE_CSE_ID=
GOOGLE_CSE_API_KEY=

# ── JWT / Auth ─────────────────────────────────────
JWT_SECRET=change_me_jwt_secret_at_least_32_chars
JWT_EXPIRY_HOURS=24

# ── ALCD Configuration ────────────────────────────
ALCD_ENABLED=true
ALCD_MIN_READINESS_SCORE=0.8
ALCD_SELF_EVAL_THRESHOLD=0.7
ALCD_SCHEDULE_INTERVAL=168h
ALCD_MAX_CONCURRENT_CRAWLS=3
ALCD_TRUSTED_DOMAINS=jdih.kemenkumham.go.id,peraturan.bpk.go.id,putusan3.mahkamahagung.go.id
ALCD_CRAWL_RATE_LIMIT=1

# ── Application ────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=info
DEBUG=true
